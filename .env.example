# SIH26189 / ICA_AI Environment Configuration Example
# Copy this file to .env and configure the variables for your environment.

# ---------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------
APP_ENV=development
APP_NAME=SIH_Intelligence_Platform
PROJECT_NAME=SIH_Intelligence_Platform

# ---------------------------------------------------------
# BACKEND API
# ---------------------------------------------------------
# This configures how the backend exposes itself
API_V1_STR=/api/v1
# CORS configuration (comma separated list of origins or wildcard)
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------
# FRONTEND
# ---------------------------------------------------------
# This configures how the frontend reaches the backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------
# DATABASE (PostgreSQL / pgvector)
# ---------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=sih26189_db

# ---------------------------------------------------------
# GRAPH DATABASE (Neo4j)
# ---------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here

# ---------------------------------------------------------
# REDIS (Caching and EventBus)
# ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------
# AUTHENTICATION & SECURITY
# ---------------------------------------------------------
# REQUIRED: Generate a secure 32+ character random string for SECRET_KEY.
# E.g., run `openssl rand -hex 32`
SECRET_KEY=your_secure_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------
# AI / LLM PROVIDERS
# ---------------------------------------------------------
# Set AI_PROVIDER to your preferred provider (openai, gemini, claude, deepseek, groq)
AI_PROVIDER=gemini

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
